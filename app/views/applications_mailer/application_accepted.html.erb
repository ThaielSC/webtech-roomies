<p>Hello <%= recipient_name(@applicant.first_name) %>,</p>

<p>Congratulations! Your application for <strong><%= @listing.title %></strong> has been accepted by <%= @host.full_name %>.</p>

<div style="background: #e8f5e9; border: 1px solid #c8e6c9; border-radius: 4px; padding: 16px; margin: 16px 0;">
  <p><strong>Property address:</strong> <%= @listing.property.address %></p>
  <p><strong>Monthly rent:</strong> <%= @listing.monthly_rent %> UF</p>
  <p><strong>Move-in date:</strong> <%= @application.move_in_date.strftime("%B %d, %Y") %></p>
  <p><strong>Host contact:</strong> <%= @host.email_address %></p>
</div>

<p>You can review your application details below:</p>
<p><%= link_to "View Application", application_url(@application) %></p>
