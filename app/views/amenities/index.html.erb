<section class="container my-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Amenities</h1>

    <% if policy(Amenity).create? %>
      <%= link_to "New amenity",
                  new_amenity_path,
                  class: "btn btn-primary" %>
    <% end %>
  </div>

  <% if @amenities.any? %>
    <ul class="list-group mt-3">
      <% @amenities.each do |amenity| %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <%= link_to amenity.name, amenity_path(amenity) %>

          <% if policy(amenity).destroy? %>
            <%= button_to "Delete",
                          amenity_path(amenity),
                          method: :delete,
                          class: "btn btn-sm btn-outline-danger",
                          form: {
                            data: {
                              turbo_confirm: "Are you sure you want to delete this amenity?"
                            }
                          } %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>No amenities found.</p>
  <% end %>
</section>
