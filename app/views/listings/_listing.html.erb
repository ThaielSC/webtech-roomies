<article class="card h-100">

  <% if listing.photos.attached? %>
    <%= image_tag listing.photos.first.variant(resize_to_fill: [600, 400]),
                  class: "card-img-top",
                  style: "height: 200px; object-fit: cover;",
                  alt: listing.title %>
  <% else %>
    <div class="bg-light d-flex align-items-center justify-content-center"
         style="height: 200px;">
      <span class="text-muted">No photograph available</span>
    </div>
  <% end %>

  <div class="card-body d-flex flex-column">
    <h2 class="card-title h5">
      <%= listing.title %>
    </h2>

    <p class="card-text">
      <strong>Neighborhood:</strong>
      <%= listing.neighborhood.name %>
    </p>

    <p class="card-text">
      <strong>Rent:</strong>
      <%= number_to_currency(listing.monthly_rent, unit: "UF ", precision: 2) %> / month
    </p>

    <p class="card-text">
      <strong>Available:</strong>
      <%= listing.available_date.strftime("%B %d, %Y") %>
    </p>

    <p class="card-text">
      <strong>Property:</strong>
      <%= listing.property.address %>
    </p>

    <p class="card-text">
      <strong>Status:</strong>
      <span class="badge text-bg-secondary">
        <%= listing.status.humanize %>
      </span>
    </p>

    <div class="d-flex flex-wrap gap-2 mt-auto">
      <%= link_to "View listing",
                  listing_path(listing),
                  class: "btn btn-primary" %>

      <%= link_to "Edit",
                  edit_listing_path(listing),
                  class: "btn btn-outline-primary" %>

      <%= button_to "Delete",
                    listing_path(listing),
                    method: :delete,
                    class: "btn btn-outline-danger",
                    form: {
                      data: {
                        turbo_confirm: "Are you sure you want to delete this listing?"
                      }
                    } %>
    </div>
  </div>
</article>