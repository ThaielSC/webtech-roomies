<section class="container my-5">

  <%= link_to "← Back to listings",
              listings_path,
              class: "btn btn-outline-secondary mb-4" %>

  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <h1 class="mb-0"><%= @listing.title %></h1>

    <div class="d-flex flex-wrap gap-2">
      <%= link_to "Edit listing",
                  edit_listing_path(@listing),
                  class: "btn btn-outline-primary" %>

      <%= button_to "Delete listing",
                    listing_path(@listing),
                    method: :delete,
                    class: "btn btn-outline-danger",
                    form: {
                      data: {
                        turbo_confirm: "Are you sure you want to delete this listing?"
                      }
                    } %>
    </div>
  </div>

  <%# PHOTOGRAPH GALLERY %>

  <h2 class="h3 mb-3">Photographs</h2>

  <% if @listing.photos.attached? %>
    <div class="row g-3 mb-5">
      <% @listing.photos.each do |photo| %>
        <div class="col-md-6 col-lg-4">
          <%= image_tag photo.variant(resize_to_limit: [900, 600]),
                        class: "img-fluid rounded shadow-sm w-100",
                        style: "height: 250px; object-fit: cover;",
                        alt: "Photograph of #{@listing.title}" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-muted mb-5">
      No photographs have been uploaded for this listing.
    </p>
  <% end %>

  <%# ROOM DETAILS %>

  <div class="row mt-4">
    <div class="col-lg-8">
      <h2 class="h4">Room details</h2>

      <p>
        <strong>Monthly rent:</strong>
        <%= number_to_currency(@listing.monthly_rent, unit: "$", precision: 0) %> CLP
      </p>

      <p>
        <strong>Deposit:</strong>
        <%= number_to_currency(@listing.deposit, unit: "$", precision: 0) %> CLP
      </p>

      <p>
        <strong>Available from:</strong>
        <%= @listing.available_date.strftime("%B %d, %Y") %>
      </p>

      <p>
        <strong>Minimum stay:</strong>
        <%= @listing.minimum_stay_months %> months
      </p>

      <p>
        <strong>Furnished:</strong>
        <%= @listing.is_furnished? ? "Yes" : "No" %>
      </p>

      <p>
        <strong>Private bathroom:</strong>
        <%= @listing.has_private_bathroom? ? "Yes" : "No" %>
      </p>

      <p>
        <strong>Status:</strong>
        <span class="badge text-bg-secondary">
          <%= @listing.status.humanize %>
        </span>
      </p>

      <%# ACTION TEXT DESCRIPTION %>

      <hr class="my-4">

      <h2 class="h4">Description</h2>

      <% if @listing.description.present? %>
        <div class="mb-4">
          <%= @listing.description %>
        </div>
      <% else %>
        <p class="text-muted">No description provided.</p>
      <% end %>

      <%# ACTION TEXT HOUSE RULES %>

      <h2 class="h4">House rules</h2>

      <% if @listing.house_rules.present? %>
        <div class="mb-4">
          <%= @listing.house_rules %>
        </div>
      <% else %>
        <p class="text-muted">No house rules provided.</p>
      <% end %>

    </div>

    <%# PROPERTY DETAILS %>

    <div class="col-lg-4">
      <div class="card">
        <div class="card-body">
          <h2 class="h4">Property</h2>

          <p>
            <strong>Address:</strong>
            <%= @listing.property.address %>
          </p>

          <p>
            <strong>Neighborhood:</strong>
            <%= @listing.neighborhood.name %>
          </p>

          <p>
            <strong>Type:</strong>
            <%= @listing.property.property_type.humanize %>
          </p>

          <p>
            <strong>Bedrooms:</strong>
            <%= @listing.property.bedrooms_count %>
          </p>

          <p>
            <strong>Bathrooms:</strong>
            <%= @listing.property.bathrooms_count %>
          </p>

          <p>
            <strong>Shared spaces:</strong>
            <%= @listing.property.shared_spaces %>
          </p>

          <%= link_to "View property",
                      property_path(@listing.property),
                      class: "btn btn-outline-primary" %>
        </div>
      </div>
    </div>
  </div>

  <hr class="my-5">

  <%# AMENITIES %>

  <h2 class="h3">Amenities</h2>

  <% if @listing.property.amenities.any? %>
    <div class="d-flex flex-wrap gap-2">
      <% @listing.property.amenities.each do |amenity| %>
        <span class="badge text-bg-secondary">
          <%= amenity.name %>
        </span>
      <% end %>
    </div>
  <% else %>
    <p>No amenities listed.</p>
  <% end %>

  <hr class="my-5">

  <%# REVIEWS %>

  <h2 class="h3">Reviews</h2>

  <% if @listing.reviews.any? %>
    <% @listing.reviews.each do |review| %>
      <div class="card mb-3">
        <div class="card-body">
          <p class="mb-1">
            <strong><%= review.user.full_name %></strong>
            — <%= review.rating %>/5
          </p>

          <p class="mb-0">
            <%= review.comment %>
          </p>
        </div>
      </div>
    <% end %>
  <% else %>
    <p>No reviews yet.</p>
  <% end %>

</section>