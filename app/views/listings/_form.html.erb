<%= form_with model: listing, html: { multipart: true } do |form| %>

  <% if listing.errors.any? %>
    <div class="alert alert-danger">
      <strong>Please correct the following errors:</strong>

      <ul class="mb-0">
        <% listing.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :property_id, "Property", class: "form-label" %>

    <%= form.collection_select :property_id,
          @properties, :id, :address,
          { prompt: "Select a property" },
          { class: "form-select", required: true } %>
  </div>

  <div class="mb-3">
    <%= form.label :title, class: "form-label" %>

    <%= form.text_field :title,
          class: "form-control",
          placeholder: "e.g. Sunny room near metro",
          required: true %>

    <% listing.errors.full_messages_for(:title).each do |message| %>
      <div class="text-danger small"><%= message %></div>
    <% end %>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= form.label :monthly_rent, "Monthly rent (CLP)", class: "form-label" %>

      <%= form.number_field :monthly_rent,
            class: "form-control",
            min: 0,
            step: 1,
            required: true %>
    </div>

    <div class="col-md-6 mb-3">
      <%= form.label :deposit, "Deposit (CLP)", class: "form-label" %>

      <%= form.number_field :deposit,
            class: "form-control",
            min: 0,
            step: 1,
            required: true %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= form.label :available_date, "Available from", class: "form-label" %>

      <%= form.date_field :available_date,
            class: "form-control",
            required: true %>
    </div>

    <div class="col-md-6 mb-3">
      <%= form.label :minimum_stay_months, "Minimum stay (months)", class: "form-label" %>

      <%= form.number_field :minimum_stay_months,
            class: "form-control",
            min: 1,
            required: true %>
    </div>
  </div>

  <div class="form-check mb-3">
    <%= form.check_box :is_furnished, class: "form-check-input" %>
    <%= form.label :is_furnished, "Furnished", class: "form-check-label" %>
  </div>

  <div class="form-check mb-4">
    <%= form.check_box :has_private_bathroom, class: "form-check-input" %>
    <%= form.label :has_private_bathroom, "Private bathroom", class: "form-check-label" %>
  </div>

  <hr class="my-4">

  <h2 class="h4">Description</h2>

  <div class="mb-4">
    <%= form.label :description, class: "form-label" %>
    <%= form.rich_text_area :description, class: "form-control" %>
  </div>

  <h2 class="h4">House rules</h2>

  <div class="mb-4">
    <%= form.label :house_rules, class: "form-label" %>
    <%= form.rich_text_area :house_rules, class: "form-control" %>
  </div>

  <hr class="my-4">

  <h2 class="h4">Photographs</h2>

  <div class="mb-4">
    <%= form.label :photos, "Upload photographs", class: "form-label" %>

    <%= form.file_field :photos,
          multiple: true,
          accept: "image/jpeg,image/png,image/webp",
          class: "form-control" %>

    <div class="form-text">
      JPEG, PNG, or WebP only. Maximum 5 MB per photograph.
    </div>
  </div>

  <% if listing.persisted? && listing.photos.attached? %>
    <div class="row g-3 mb-4">
      <% listing.photos.each do |photo| %>
        <div class="col-6 col-md-3">
          <%= image_tag photo.variant(resize_to_limit: [240, 180]),
                        class: "img-fluid rounded",
                        alt: "Listing photograph" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="d-flex gap-2">
    <%= form.submit class: "btn btn-primary" %>

    <%= link_to "Cancel",
          listing.persisted? ? listing_path(listing) : listings_path,
          class: "btn btn-outline-secondary" %>
  </div>

<% end %>