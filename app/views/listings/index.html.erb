<section class="container my-5">
  <h1 class="mb-4">Available Rooms</h1>

  <% if @listings.any? %>
    <div class="row g-4">
      <% @listings.each do |listing| %>
        <div class="col-md-6 col-lg-4">
          <%= render listing %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p>No published listings are currently available.</p>
  <% end %>
</section>