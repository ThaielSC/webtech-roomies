<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Webtech Roomies" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Webtech Roomies">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header>
      <nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom">
        <div class="container">

          <%= link_to "Roomies", root_path, class: "navbar-brand fw-bold" %>

          <button class="navbar-toggler"
                  type="button"
                  data-bs-toggle="collapse"
                  data-bs-target="#mainNavbar"
                  aria-controls="mainNavbar"
                  aria-expanded="false"
                  aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>

          <div class="collapse navbar-collapse" id="mainNavbar">
            <div class="navbar-nav ms-auto align-items-lg-center">

              <%= link_to "Listings",
                          listings_path,
                          class: "nav-link" %>

              <%= link_to "Properties",
                          properties_path,
                          class: "nav-link" %>

              <%= link_to "Neighborhoods",
                          neighborhoods_path,
                          class: "nav-link" %>

              <% if current_user&.moderator? %>
                <%= link_to "Amenities",
                            amenities_path,
                            class: "nav-link" %>
              <% end %>

              <%= link_to "Reviews",
                          reviews_path,
                          class: "nav-link" %>

              <% if current_user&.moderator? %>
                <%= link_to "Reports",
                            reports_path,
                            class: "nav-link" %>
              <% end %>

              <% if authenticated? %>

                <%= link_to "Applications",
                            applications_path,
                            class: "nav-link" %>

                <%= link_to "My profile",
                            profile_path,
                            class: "nav-link" %>

                <span class="navbar-text ms-lg-3 me-lg-2">
                  <%= Current.user.full_name %>
                </span>

                <%= button_to "Sign out",
                              session_path,
                              method: :delete,
                              class: "btn btn-outline-danger btn-sm ms-lg-2" %>

              <% else %>

                <%= link_to "Sign in",
                            new_session_path,
                            class: "nav-link" %>

                <%= link_to "Sign up",
                            new_registration_path,
                            class: "btn btn-primary btn-sm ms-lg-3" %>

              <% end %>

            </div>
          </div>

        </div>
      </nav>
    </header>

    <main>
      <div class="container pt-3" id="flash-messages">
        <%= render "shared/flash" %>
      </div>

      <%= yield %>
    </main>

    <footer class="border-top mt-5 py-4 bg-body-tertiary">
      <div class="container text-center">
        <p class="mb-1"><strong>Team Rocket</strong></p>
        <p class="mb-1">Thaiel Santiago &amp; Cristóbal Toro</p>
        <p class="text-muted mb-0">Web Technologies - 2026</p>
      </div>
    </footer>
  </body>
</html>