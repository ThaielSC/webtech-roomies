<tr id="application_<%= application.id %>">
  <td><%= application.user.full_name %></td>

  <td>
    <%= link_to application.listing.title,
                listing_path(application.listing) %>
  </td>

  <td><%= l(application.move_in_date) %></td>
  <td><%= application.intended_stay_months %> months</td>

  <td>
    <span class="badge text-bg-secondary">
      <%= application.status.humanize %>
    </span>
  </td>

  <td>
    <div class="d-flex flex-wrap gap-2">
      <%= link_to "View",
                  application_path(application),
                  class: "btn btn-sm btn-primary" %>

      <% if policy(application).edit? %>
        <%= link_to "Edit",
                    edit_application_path(application),
                    class: "btn btn-sm btn-outline-primary" %>
      <% end %>

      <% if application.pending? && policy(application).shortlist? %>
        <%= button_to "Shortlist",
                      shortlist_application_path(application),
                      method: :patch,
                      class: "btn btn-sm btn-outline-primary" %>
      <% end %>

      <% if (application.pending? || application.shortlisted?) &&
            policy(application).reject? %>
        <%= button_to "Reject",
                      reject_application_path(application),
                      method: :patch,
                      class: "btn btn-sm btn-outline-danger" %>
      <% end %>

      <% if (application.pending? || application.shortlisted?) &&
            policy(application).accept? %>
        <%= button_to "Accept",
                      accept_application_path(application),
                      method: :patch,
                      class: "btn btn-sm btn-success" %>
      <% end %>

      <% if policy(application).destroy? %>
        <%= button_to "Withdraw",
                      application_path(application),
                      method: :delete,
                      class: "btn btn-sm btn-outline-danger" %>
      <% end %>
    </div>
  </td>
</tr>
