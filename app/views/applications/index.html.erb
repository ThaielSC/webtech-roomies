<section class="container my-5">
  <h1 class="mb-4">Application inbox</h1>
  <p id="pending-count" class="text-muted"><%= @pending_count %> pending</p>

  <% if @applications.any? %>
    <div class="table-responsive">
      <table class="table table-striped align-middle">
        <thead>
          <tr>
            <th>Applicant</th>
            <th>Listing</th>
            <th>Move-in date</th>
            <th>Stay</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>
          <% @applications.each do |application| %>
            <%= render "row", application: application %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="alert alert-info">
      No applications found.
    </div>
  <% end %>
</section>