<section class="container my-5">
  <h1 class="mb-4">Applications</h1>

  <% if @applications.any? %>
    <div class="table-responsive">
      <table class="table table-striped align-middle">
        <thead>
          <tr>
            <th>Applicant</th>
            <th>Listing</th>
            <th>Move-in date</th>
            <th>Stay</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>
          <% @applications.each do |application| %>
            <tr>
              <td>
                <%= application.user.full_name %>
              </td>

              <td>
                <%= link_to application.listing.title,
                            listing_path(application.listing) %>
              </td>

              <td>
                <%= application.move_in_date.strftime("%B %d, %Y") %>
              </td>

              <td>
                <%= application.intended_stay_months %> months
              </td>

              <td>
                <span class="badge text-bg-secondary">
                  <%= application.status.humanize %>
                </span>
              </td>

              <td>
                <div class="d-flex flex-wrap gap-2">
                  <%= link_to "View",
                              application_path(application),
                              class: "btn btn-sm btn-primary" %>

                  <% if application.pending? || application.shortlisted? %>
                    <%= link_to "Edit",
                                edit_application_path(application),
                                class: "btn btn-sm btn-outline-primary" %>

                    <%= button_to "Withdraw",
                                  application_path(application),
                                  method: :delete,
                                  class: "btn btn-sm btn-outline-danger",
                                  form: {
                                    data: {
                                      turbo_confirm: "Are you sure you want to withdraw this application?"
                                    }
                                  } %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="alert alert-info">
      No applications found.
    </div>
  <% end %>
</section>