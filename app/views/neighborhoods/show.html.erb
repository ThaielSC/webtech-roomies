<section class="container my-5">
  <%= link_to "← Back to neighborhoods",
              neighborhoods_path,
              class: "btn btn-outline-secondary mb-4" %>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1><%= @neighborhood.name %></h1>

    <div class="d-flex gap-2">
      <%= link_to "Edit neighborhood",
                  edit_neighborhood_path(@neighborhood),
                  class: "btn btn-outline-primary" %>

      <%= button_to "Delete neighborhood",
                    neighborhood_path(@neighborhood),
                    method: :delete,
                    class: "btn btn-outline-danger",
                    form: {
                      data: {
                        turbo_confirm: "Are you sure you want to delete this neighborhood?"
                      }
                    } %>
    </div>
  </div>

  <p class="text-muted">
    <%= pluralize(@neighborhood.properties.count, "property") %>
  </p>

  <hr class="my-5">

  <h2 class="h3">Listings in <%= @neighborhood.name %></h2>

  <% if @neighborhood.listings.any? %>
    <div class="row g-4">
      <% @neighborhood.listings.each do |listing| %>
        <div class="col-md-6 col-lg-4">
          <%= render "listings/listing", listing: listing %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p>No listings found in this neighborhood.</p>
  <% end %>
</section>