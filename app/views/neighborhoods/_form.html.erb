<%= form_with model: neighborhood do |form| %>
  <% if neighborhood.errors.any? %>
    <div class="alert alert-danger">
      <%= neighborhood.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control", required: true,
                        placeholder: "e.g. Providencia" %>
    <% neighborhood.errors.full_messages_for(:name).each do |message| %>
      <div class="text-danger small"><%= message %></div>
    <% end %>
  </div>

  <%= form.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", neighborhoods_path, class: "btn btn-outline-secondary" %>
<% end %>