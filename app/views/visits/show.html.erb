<section class="container my-5">

  <%= link_to "← Back to visits",
              visits_path,
              class: "btn btn-outline-secondary mb-4" %>

  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <h1 class="mb-0">Visit details</h1>

    <div class="d-flex flex-wrap gap-2">

      <% if @visit.proposed? || @visit.confirmed? %>
        <%= link_to "Reschedule",
                    edit_visit_path(@visit),
                    class: "btn btn-outline-primary" %>
      <% end %>

      <% if @visit.proposed? %>
        <%= button_to "Confirm",
                      confirm_visit_path(@visit),
                      method: :patch,
                      class: "btn btn-outline-success" %>
      <% end %>

      <% if @visit.proposed? || @visit.confirmed? %>
        <%= button_to "Cancel",
                      cancel_visit_path(@visit),
                      method: :patch,
                      class: "btn btn-outline-warning" %>
      <% end %>

      <% if @visit.confirmed? %>
        <%= button_to "Complete",
                      complete_visit_path(@visit),
                      method: :patch,
                      class: "btn btn-success" %>
      <% end %>

    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body">

      <p>
        <strong>Applicant:</strong>
        <%= @visit.application.user.full_name %>
      </p>

      <p>
        <strong>Listing:</strong>
        <%= link_to @visit.application.listing.title,
                    listing_path(@visit.application.listing) %>
      </p>

      <p>
        <strong>Date and time:</strong>
        <%= @visit.date_time.strftime("%B %d, %Y at %H:%M") %>
      </p>

      <p>
        <strong>Status:</strong>
        <span class="badge text-bg-secondary">
          <%= @visit.status.humanize %>
        </span>
      </p>

      <p>
        <strong>Notes:</strong>
        <%= @visit.notes.presence || "No notes provided." %>
      </p>

      <%= link_to "View application",
                  application_path(@visit.application),
                  class: "btn btn-outline-primary" %>

    </div>
  </div>

  <%# REVIEW SECTION %>

  <hr class="my-5">

  <h2 class="h3 mb-4">Review</h2>

  <% if @visit.review.present? %>

    <div class="card mb-4">
      <div class="card-body">

        <p>
          <strong>Rating:</strong>

          <span class="text-warning">
            <%= "★" * @visit.review.rating %>
          </span>
        </p>

        <p>
          <strong>Comment:</strong>
          <%= @visit.review.comment %>
        </p>

        <%= link_to "View review",
                    review_path(@visit.review),
                    class: "btn btn-outline-primary" %>

      </div>
    </div>

  <% elsif @visit.completed? %>

    <div class="alert alert-success">
      This visit has been completed.
      You can now write a review of the property.
    </div>

    <%= link_to "Write review",
                new_review_path(visit_id: @visit.id),
                class: "btn btn-success" %>

  <% else %>

    <div class="alert alert-info">
      Reviews become available after the visit is completed.
    </div>

  <% end %>

</section>