<section class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-8">

      <h1 class="mb-4">Edit profile</h1>

      <%= form_with model: @user, url: profile_path do |form| %>

        <% if @user.errors.any? %>
          <div class="alert alert-danger">
            <ul class="mb-0">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="mb-3">
          <%= form.label :first_name, class: "form-label" %>
          <%= form.text_field :first_name, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= form.label :last_name, class: "form-label" %>
          <%= form.text_field :last_name, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= form.label :email_address, "Email", class: "form-label" %>
          <%= form.email_field :email_address, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= form.label :phone_number, class: "form-label" %>
          <%= form.telephone_field :phone_number, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= form.label :bio, class: "form-label" %>
          <%= form.text_area :bio,
                             class: "form-control",
                             rows: 4 %>
        </div>

        <div class="d-flex gap-2">
          <%= form.submit "Save changes", class: "btn btn-primary" %>

          <%= link_to "Cancel",
                      profile_path,
                      class: "btn btn-outline-secondary" %>
        </div>

      <% end %>

    </div>
  </div>
</section>