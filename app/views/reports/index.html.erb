<section class="container my-5">
  <h1>Reports</h1>
  <p class="text-muted">Review and moderate reported listings.</p>

  <% if @reports.any? %>
    <div class="table-responsive">
      <table class="table table-striped align-middle">
        <thead>
          <tr>
            <th>ID</th>
            <th>Listing</th>
            <th>Reported by</th>
            <th>Reason</th>
            <th>Status</th>
            <th>Submitted</th>
            <th></th>
          </tr>
        </thead>

        <tbody>
          <% @reports.each do |report| %>
            <tr>
              <td><%= report.id %></td>
              <td><%= report.listing.title %></td>
              <td><%= report.user.full_name %></td>
              <td><%= report.reason_category.humanize %></td>
              <td>
                <span class="badge text-bg-secondary">
                  <%= report.status.humanize %>
                </span>
              </td>
              <td><%= report.created_at.strftime("%Y-%m-%d") %></td>
              <td>
                <%= link_to "Review",
                            report_path(report),
                            class: "btn btn-outline-primary btn-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p>No reports have been submitted.</p>
  <% end %>
</section>
