<section class="container my-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Properties</h1>

    <%= link_to "Add property",
                new_property_path,
                class: "btn btn-success" %>
  </div>

  <% if @properties.any? %>
    <div class="row g-4">
      <% @properties.each do |property| %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100">
            <div class="card-body">
              <h2 class="card-title h5">
                <%= property.address %>
              </h2>

              <p>
                <strong>Neighborhood:</strong>
                <%= property.neighborhood.name %>
              </p>

              <p>
                <strong>Type:</strong>
                <%= property.property_type.humanize %>
              </p>

              <p>
                <strong>Bedrooms:</strong>
                <%= property.bedrooms_count %>
              </p>

              <p>
                <strong>Bathrooms:</strong>
                <%= property.bathrooms_count %>
              </p>

              <div class="d-flex flex-wrap gap-2 mt-3">
                <%= link_to "View property",
                            property_path(property),
                            class: "btn btn-primary" %>

                <%= link_to "Edit",
                            edit_property_path(property),
                            class: "btn btn-outline-primary" %>

                <%= button_to "Delete",
                              property_path(property),
                              method: :delete,
                              class: "btn btn-outline-danger",
                              form: {
                                data: {
                                  turbo_confirm: "Are you sure you want to delete this property?"
                                }
                              } %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p>No properties found.</p>
  <% end %>
</section>